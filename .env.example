# Modèle de configuration ELMES-QUIZ — copier en .env.local et remplir. Ne jamais committer de vraies valeurs.

# ── Obligatoires ──────────────────────────────────────────────────
MONGO_URI=
# Secret long et aléatoire (32 caractères minimum). Sans lui, l'application refuse de démarrer.
# Exemple de génération : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# ── Paiements (FlexPay, via le service intermédiaire) ─────────────
PAYMENT_API_URL=
FLEX_IN=
FLEX_TOKEN=
FLEX_MOBILE=
FLEX_CARD=
FLEX_CHECKIN=
FLEX_AUTH=
FLEX_OUT=
FLEX_LOGIN=
FLEX_CHECKOUT=
FLEX_BALANCE=
# URL publique de l'application (callback FlexPay et liens de vérification)
HOST=
NEXT_PUBLIC_APP_URL=
APP_URL=
PAYMENT_VERIFICATION_URL=

# ── Règles financières (lot 3) ────────────────────────────────────
# Taux unique USD → CDF pour l'équivalent comptable des paiements en USD (Q-02). Défaut : 2800.
USD_CDF_RATE=
# Commission du fournisseur déduite avant la répartition 35 % / 65 % de la Bourse (Q-01). Défaut : 0.035.
PAYMENT_COMMISSION_RATE=
# Plafond de retrait sur 24 heures, en CDF (Q-03). Vide : pas de plafond.
RETRAIT_PLAFOND_JOURNALIER_CDF=

# ── Optionnels ────────────────────────────────────────────────────
# Redis : limitation des tentatives de connexion et du formulaire de contact (repli en mémoire sinon).
REDIS_URL=
CLOUDINARY_NAME=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=
# E-mail : voir les clés lues dans lib/utils/mail.ts (MAIL_USER, MAIL_FROM, …)
MAIL_USER=
MAIL_FROM=
